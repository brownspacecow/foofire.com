      "tutorial": [
        {
          "when": "start",
          "text": "New neighbours are coming. A Lair lets creatures sleep and makes room for more of them. A Hatchery keeps them fed."
        },
        {
          "when": "room:lair",
          "text": "Lovely blankets. Now paint a Hatchery so nobody chews the furniture."
        },
        {
          "when": "wave",
          "text": "Tap a creature with the Hand to pick it up, then tap the floor to drop it somewhere useful. The Slap tool gives a creature a burst of get-up-and-go."
        }
      ],
      "outro": "Two whole waves, tidied away. The lair smells like socks and victory."
