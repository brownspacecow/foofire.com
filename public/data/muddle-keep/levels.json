      ],
      "startGold": 260,
      "startMana": 70,
      "imps": 3,
      "heartHealth": 700,
      "startCreatures": [{ "type": "grumblet", "count": 3 }],
      "availableRooms": ["treasury", "lair", "hatchery"],
      "availableSpells": ["haste", "heal", "rally"],
      "availableTraps": [],
      "waves": [
        {
          "at": 80,
          "label": "A very tidy patrol",
          "spawn": [{ "type": "squire", "count": 3 }]
        }
      ],
      "tutorial": [
        {
          "when": "start",
          "text": "Welcome, Keeper! You are the floating hand. Pick Dig and drag over brown dirt to plan a tunnel — it can reach into the dark, and imps start as soon as a path gets there. Drag over planned tiles again to un-plan."
        },
        {
          "when": "dug",
          "text": "Nice digging — the floor is yours now. Pick Rooms, choose Treasury, and paint a few tiles."
        },
        {
          "when": "room",
          "text": "Gold goes in the Treasury. Your creatures sleep, eat and train in rooms too. Keep an eye on the top bar."
        },
        {
          "when": "wave",
          "text": "Knights! They march for the Dungeon Heart. Your creatures fight on their own — use spells and the Rally Yell to help."
        }
      ],
      "outro": "The patrol went home muddy and confused. Word is spreading about the nice monster down the hole."
    },
